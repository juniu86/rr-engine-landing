# Variáveis públicas (entram no bundle do site).
# Copie para .env (não versionado) e preencha conforme você criar as contas.

# Google Analytics 4 — formato G-XXXXXXXXXX
# Para criar: https://analytics.google.com → Admin → Data Streams → Web → coletar Measurement ID
PUBLIC_GA_ID=

# Google Search Console — token de verificação via meta tag
# Para criar: https://search.google.com/search-console → Add Property → engine.rres.com.br
# → método "HTML tag" → copiar só o valor do content="..." da meta tag fornecida
PUBLIC_GSC_TOKEN=
