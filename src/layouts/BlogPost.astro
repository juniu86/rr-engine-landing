---
import "../styles/blog.css";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
  readingTime?: string;
  slug: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  author = "Reginaldo Rodrigues",
  readingTime,
  slug,
} = Astro.props;

const SITE_URL = "https://engine.rres.com.br";
const canonicalUrl = `${SITE_URL}/blog/${slug}/`;
const GA_ID = import.meta.env.PUBLIC_GA_ID || "";
const GSC_TOKEN = import.meta.env.PUBLIC_GSC_TOKEN || "";

const formatDate = (d: Date) =>
  new Intl.DateTimeFormat("pt-BR", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  }).format(d);

// Schema.org BlogPosting
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  url: canonicalUrl,
  inLanguage: "pt-BR",
  author: {
    "@type": "Person",
    name: author,
  },
  publisher: {
    "@type": "Organization",
    name: "RR Engenharia",
    logo: {
      "@type": "ImageObject",
      url: `${SITE_URL}/logo.png`,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Blog RR Engine</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A1F44" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />

    <meta property="og:title" content={`${title} — RR Engine`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={`${SITE_URL}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="RR Engine" />
    <meta
      property="article:published_time"
      content={pubDate.toISOString()}
    />
    {
      updatedDate && (
        <meta
          property="article:modified_time"
          content={updatedDate.toISOString()}
        />
      )
    }
    <meta property="article:author" content={author} />
    {tags.map((t) => <meta property="article:tag" content={t} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — RR Engine`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}/og-image.png`} />

    {
      GSC_TOKEN && (
        <meta name="google-site-verification" content={GSC_TOKEN} />
      )
    }

    <script
      type="application/ld+json"
      set:html={JSON.stringify(articleSchema)}
    />

    {
      GA_ID && (
        <>
          <script
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
          />
          <script
            set:html={`window.dataLayer = window.dataLayer || [];function gtag(){dataLayer.push(arguments);}gtag('js', new Date());gtag('config', '${GA_ID}', { anonymize_ip: true });`}
          />
        </>
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo">
          <img src="/logo.png" alt="RR Engenharia" class="logo-img" />
          <span>RR Engine</span>
        </a>
        <nav>
          <a href="/blog">Blog</a>
          <a href="/#planos">Planos</a>
          <a href="/#faq">FAQ</a>
          <a
            href="https://engine.rres.com.br"
            class="nav-login"
            rel="noopener">Entrar</a
          >
          <a href="/#contato" class="nav-cta">Fazer demo</a>
        </nav>
      </div>
    </header>

    <div class="bg-mesh" aria-hidden="true"></div>

    <main class="blog-main">
      <article class="blog-article container container-narrow">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">›</span>
          <a href="/blog">Blog</a>
          <span aria-hidden="true">›</span>
          <span class="current">{title}</span>
        </nav>

        <header class="blog-header">
          {
            tags.length > 0 && (
              <div class="blog-tags">
                {tags.map((t) => (
                  <span class="blog-tag">{t}</span>
                ))}
              </div>
            )
          }
          <h1>{title}</h1>
          <p class="blog-description">{description}</p>
          <div class="blog-meta">
            <span>{author}</span>
            <span aria-hidden="true">•</span>
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
            {readingTime && (
              <>
                <span aria-hidden="true">•</span>
                <span>{readingTime}</span>
              </>
            )}
          </div>
        </header>

        <div class="blog-content glass">
          <slot />
        </div>

        <aside class="blog-cta glass">
          <h3>Pronto pra parar de perder noites com orçamento?</h3>
          <p>
            O RR Engine recebe seu memorial descritivo e entrega proposta
            comercial, memória de cálculo e cronograma em 10 minutos.
          </p>
          <a href="https://engine.rres.com.br/sign-up" class="cta-button"
            >Testar grátis</a
          >
        </aside>
      </article>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p class="footer-copy">
          © {new Date().getFullYear()} RR Engenharia. Todos os direitos reservados.
        </p>
      </div>
    </footer>
  </body>
</html>
