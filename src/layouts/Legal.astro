---
const { title, description, lastUpdated } = Astro.props;
const SITE_URL = "https://engine.rres.com.br";
const pagePath = Astro.url.pathname;
const canonicalUrl = `${SITE_URL}${pagePath}`;
const GA_ID = import.meta.env.PUBLIC_GA_ID || "";
const GSC_TOKEN = import.meta.env.PUBLIC_GSC_TOKEN || "";

// Schema.org Article para páginas legais
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": "2026-05-04",
  "dateModified": lastUpdated,
  "url": canonicalUrl,
  "inLanguage": "pt-BR",
  "publisher": {
    "@type": "Organization",
    "name": "RR Engenharia",
    "logo": {
      "@type": "ImageObject",
      "url": `${SITE_URL}/logo.png`,
    },
  },
};
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — RR Engine</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0A1F44" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="index, follow" />

  <!-- Open Graph -->
  <meta property="og:title" content={`${title} — RR Engine`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:image" content={`${SITE_URL}/og-image.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="RR Engine" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} — RR Engine`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${SITE_URL}/og-image.png`} />

  {GSC_TOKEN && <meta name="google-site-verification" content={GSC_TOKEN} />}

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  {GA_ID && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
      <script set:html={`window.dataLayer = window.dataLayer || [];function gtag(){dataLayer.push(arguments);}gtag('js', new Date());gtag('config', '${GA_ID}', { anonymize_ip: true });`}></script>
    </>
  )}
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo">
        <img src="/logo.png" alt="RR Engenharia" class="logo-img" />
        <span>RR Engine</span>
      </a>
      <nav>
        <a href="/#planos">Planos</a>
        <a href="/blog">Blog</a>
        <a href="/#faq">FAQ</a>
        <a href="https://engine.rres.com.br" class="nav-login" rel="noopener">Entrar</a>
        <a href="/#contato" class="nav-cta">Fazer demo</a>
      </nav>
    </div>
  </header>

  <div class="bg-mesh" aria-hidden="true"></div>

  <main class="legal-main">
    <article class="legal-article container container-narrow glass">
      <h1>{title}</h1>
      <p class="last-updated">Última atualização: {lastUpdated}</p>
      <slot />
    </article>
  </main>

  <footer class="site-footer">
    <div class="container">
      <p class="footer-copy">© {new Date().getFullYear()} RR Engenharia. Todos os direitos reservados.</p>
    </div>
  </footer>
</body>
</html>

<style is:global>
  :root {
    --bg-primary: #050d1f;
    --bg-secondary: #0a1f44;
    --bg-card: rgba(15, 40, 85, 0.55);
    --border: rgba(255, 255, 255, 0.08);
    --text: #ffffff;
    --text-secondary: #cbd5e1;
    --text-muted: #94a3b8;
    --accent: #1652f0;
    --accent-hover: #0e3dc4;
    --cyan: #06b6d4;
    --container: 1200px;
    --container-narrow: 768px;
    --radius: 16px;
    --radius-sm: 8px;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: var(--text);
    background: var(--bg-primary);
    line-height: 1.7;
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    position: relative;
  }

  .bg-mesh {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 40% at 20% 0%, rgba(22, 82, 240, 0.20), transparent 60%),
      radial-gradient(ellipse 50% 35% at 80% 10%, rgba(6, 182, 212, 0.14), transparent 60%),
      linear-gradient(180deg, var(--bg-secondary) 0%, var(--bg-primary) 100%);
  }

  .glass {
    background: var(--bg-card);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .container {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .container-narrow { max-width: var(--container-narrow); }

  .site-header {
    position: sticky;
    top: 0;
    background: rgba(5, 13, 31, 0.78);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
    z-index: 100;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    text-decoration: none;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .logo-img { height: 36px; width: auto; display: block; }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .site-header nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.92rem;
    transition: color 0.15s;
  }

  .site-header nav a:hover { color: var(--text); }

  .nav-cta {
    background: var(--accent);
    color: #fff !important;
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  .nav-cta:hover { background: var(--accent-hover); }

  /* LEGAL ARTICLE */
  .legal-main { padding: 4rem 0 5rem; }

  .legal-article {
    padding: 2.5rem 2rem;
  }

  @media (max-width: 640px) {
    .legal-article { padding: 1.75rem 1.25rem; }
  }

  .legal-article h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
    font-weight: 800;
    color: var(--text);
  }

  .last-updated {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .legal-article h2 {
    font-size: 1.35rem;
    margin: 2.5rem 0 1rem;
    letter-spacing: -0.01em;
    color: var(--text);
    font-weight: 700;
  }

  .legal-article h3 {
    font-size: 1.05rem;
    margin: 1.5rem 0 0.5rem;
    color: var(--text);
    font-weight: 600;
  }

  .legal-article p {
    color: var(--text-secondary);
    margin: 0.75rem 0;
  }

  .legal-article ul, .legal-article ol {
    color: var(--text-secondary);
    padding-left: 1.5rem;
    margin: 0.75rem 0;
  }

  .legal-article li { margin: 0.4rem 0; }

  .legal-article a {
    color: var(--cyan);
    text-decoration: underline;
    text-decoration-color: rgba(6, 182, 212, 0.4);
    text-underline-offset: 2px;
    transition: color 0.15s;
  }

  .legal-article a:hover {
    color: #67e8f9;
    text-decoration-color: var(--cyan);
  }

  .legal-article strong {
    color: var(--text);
    font-weight: 600;
  }

  .site-footer {
    background: var(--bg-secondary);
    padding: 2rem 0;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .footer-copy {
    margin: 0;
    text-align: center;
  }

  @media (max-width: 640px) {
    .site-header nav { gap: 1rem; }
    .site-header nav a:not(.nav-cta) { display: none; }
  }
</style>
